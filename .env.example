# Copy this file to `.env` and fill in your real Stripe keys (keep `.env` out of git).
# Get your keys from: https://dashboard.stripe.com/apikeys

# Publishable key — safe to expose in the browser. Must be VITE_ prefixed to be
# readable from client code via import.meta.env.VITE_STRIPE_PUBLISHABLE_KEY
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Secret key — SERVER-SIDE ONLY. Never prefix with VITE_ and never use it in
# frontend code; it must live on a backend / serverless function.
# In production set this in Vercel → Settings → Environment Variables (NOT here).
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Webhook signing secret — SERVER-SIDE ONLY. From Stripe Dashboard → Developers →
# Webhooks → your endpoint (/api/stripe-webhook) → "Signing secret".
# Required for api/stripe-webhook.ts to verify events. Set in Vercel env.
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Confirmation email (Resend) — SERVER-SIDE ONLY. Sent by the webhook on payment.
# Get the key at https://resend.com/api-keys. If unset, the email is skipped.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# The live Zoom meeting link included in the confirmation email (falls back to a
# placeholder until set). Set the real recurring meeting link before launch.
ZOOM_LINK=https://zoom.us/j/xxxxxxxxxxx
# From address for the email. Use a verified domain in production; the default
# "onboarding@resend.dev" only works for testing to your own address.
SENDER_EMAIL=The K2 Academy <onboarding@resend.dev>

# Capacity — hard seat cap enforced server-side (default 25). WORKSHOP_ID tags
# this cohort's Stripe sessions so only its paid seats are counted.
MAX_SEATS=25
WORKSHOP_ID=Workshop_Aug26

# Google Sheet / CRM webhook (e.g. an Apps Script Web App URL). Buyers are POSTed
# here on payment (tag Workshop_Aug26_Buyer) and waitlist leads (tag Workshop_Waitlist).
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/xxxxx/exec

# Admin sales alert — if set, an instant email is sent here on each sale (needs RESEND_API_KEY).
ADMIN_NOTIFICATION_EMAIL=owner@example.com

# Optional fallback — static Stripe Payment Links (Dashboard → Payment Links).
# Used by the client only if the /api/create-checkout-session call fails.
# BASE = ticket only ($97), BUMP = ticket + order bump ($124). Leave blank to disable.
VITE_STRIPE_PAYMENT_URL_BASE=https://buy.stripe.com/xxxxxxxxxxxxxxxx
VITE_STRIPE_PAYMENT_URL_BUMP=https://buy.stripe.com/yyyyyyyyyyyyyyyy

# Meta (Facebook) Pixel ID. When set, src/lib/track.ts initializes the pixel and
# fires PageView on load, InitiateCheckout on checkout clicks and Purchase on
# /thank-you. Inlined at BUILD time: redeploy after changing it. Blank = disabled.
# The stripe-webhook also reads it for the Conversions API (or set META_PIXEL_ID).
VITE_META_PIXEL_ID=

# Meta Conversions API (server-side Purchase from the Stripe webhook).
# Events Manager → dataset → Settings → Conversions API → Generate access token.
# SERVER-SIDE ONLY - never prefix with VITE_. Blank = CAPI skipped.
META_CAPI_ACCESS_TOKEN=
# Optional: Events Manager → Test events code (e.g. TEST12345) while verifying.
# Remove it afterwards, or real purchases keep landing in Test events only.
META_TEST_EVENT_CODE=

# Public site origin used for absolute og:image / og:url / canonical tags in
# index.html (no trailing slash), e.g. https://webinar.example.com. Optional on
# Vercel: falls back to VERCEL_PROJECT_PRODUCTION_URL, then VERCEL_URL.
SITE_URL=
