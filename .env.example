# Copy this file to `.env` and fill in your real values (keep `.env` out of git).
# The webinar is free: there is no payment provider to configure.

# Registration webhook (Zapier / Make / n8n / Apps Script, etc.). The opt-in form
# POSTs JSON { name, email, phone, marketingConsent, submittedAt } here from the
# browser, so the endpoint must allow cross-origin requests (CORS). Inlined at BUILD time: redeploy after
# changing it. Blank = the payload is logged to the browser console instead.
VITE_LEAD_WEBHOOK_URL=

# WhatsApp updates-group invite link for the /thank-you page button.
# Inlined at BUILD time: redeploy after changing it. Blank = the default group link
# hardcoded in src/components/ThankYouPage.tsx.
VITE_WHATSAPP_GROUP_URL=

# Google Sheet webhook (Apps Script Web App URL) for page analytics. Each visit
# is one row, upserted by /api/track-event (tag Workshop_Analytics).
# SERVER-SIDE ONLY - never prefix with VITE_.
GOOGLE_SHEET_WEBHOOK_URL=https://script.google.com/macros/s/xxxxx/exec

# Meta (Facebook) Pixel ID. When set, src/lib/track.ts initializes the pixel and
# fires PageView on load and Lead on the /thank-you page after a registration.
# Inlined at BUILD time: redeploy after changing it. Blank = disabled.
VITE_META_PIXEL_ID=

# Public site origin used for absolute og:image / og:url / canonical tags in
# index.html (no trailing slash), e.g. https://webinar.example.com. Optional on
# Vercel: falls back to VERCEL_PROJECT_PRODUCTION_URL, then VERCEL_URL.
SITE_URL=
